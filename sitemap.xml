---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "item", "item.sitemap != false" | sort: "url" %}
{%- for item in pages %}
  <url>
    <loc>{{ item.url | replace: "index.html", "" | absolute_url | xml_escape }}</loc>
    {%- if item.last_modified_at %}
    <lastmod>{{ item.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
{%- for post in site.posts %}
{%- unless post.sitemap == false %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
